@startuml sequence_recommendation
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220

skinparam participant {
  BackgroundColor #EAF0F6
  BorderColor #17324D
  FontColor #17324D
  FontStyle bold
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #17324D
  FontColor #17324D
}
skinparam note {
  BackgroundColor #E8F7EF
  BorderColor #16A36A
  FontColor #182230
}

title Biểu đồ Trình tự (UC_04): Gợi ý khu vực tối ưu đa tiêu chí

actor "Người dùng" as User
participant "PreferenceForm\n<<component>>" as Form
participant "RecommendationsPage\n<<component>>" as Page
participant "StoreContext\n<<context>>" as Store
participant "RecommendationEngine\n<<module>>" as Engine
participant "CostCalculator\n<<module>>" as Cost
participant "DistanceCalculator\n<<module>>" as Dist

User -> Form : 1. Chọn city, monthlyBudget, maximumRent,\ndestination, maximumDistanceKm, priorities
activate Form

Form -> Page : 2. onChange(preferences) / onSubmit()
activate Page

Page -> Store : 3. useStore() -> đọc areas
activate Store
Store --> Page : 4. areas : Area[]
deactivate Store

Page -> Engine : 5. recommendAreas(areas, preferences)
activate Engine

Engine -> Engine : 6. Lọc theo city &\nchuẩn hóa trọng số W1..W4 = 100%

loop với mỗi Area trong cityFiltered
  Engine -> Cost : 7. calculateAreaTotalCost(rent.average, monthlyExpenses)
  activate Cost
  Cost --> Engine : 8. totalCost : number
  deactivate Cost

  Engine -> Engine : 9. Tính budgetScore\n(trừ điểm nếu vượt monthlyBudget / maximumRent)

  opt preferences.destination != null
    Engine -> Dist : 10. calculateDistance(area.lat, area.lng, dest.lat, dest.lng)
    activate Dist
    Dist --> Engine : 11. distanceKm : number (Haversine)
    deactivate Dist
    Engine -> Engine : 12. Tính commuteScore
  end

  Engine -> Engine : 13. Tính amenitiesScore, environmentScore,\ntotalScore (0..100) & reasons[]
end

Engine -> Engine : 14. Sắp xếp giảm dần theo totalScore & gán rank
Engine --> Page : 15. recommendations : RecommendedArea[]
deactivate Engine

alt recommendations.length > 0
  Page --> User : 16a. Hiển thị danh sách RecommendationCard\nvà biểu đồ cột Top 5 (Recharts)
else recommendations.length == 0
  Page --> User : 16b. Hiển thị EmptyState\n(kèm nút Khôi phục tiêu chí mặc định)
end

deactivate Page
deactivate Form
@enduml
