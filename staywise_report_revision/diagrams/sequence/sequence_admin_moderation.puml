@startuml sequence_admin_moderation
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220

skinparam participant {
  BackgroundColor #EAF0F6
  BorderColor #17324D
  FontColor #17324D
  FontStyle bold
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #17324D
}
skinparam database {
  BackgroundColor #F7F9FC
  BorderColor #475569
}

title Biểu đồ Trình tự (UC_06 - Luồng B): Admin kiểm duyệt & Cộng đồng hiển thị

actor "Quản trị viên\n(Admin Demo)" as Admin
participant "AdminContributionsPage\n<<component>>" as AdminPage
participant "StoreContext\n<<context>>" as Store
participant "storageService\n<<module>>" as Storage
database "localStorage\n<<browser>>" as LS
participant "ToastContext\n<<context>>" as Toast
participant "CommunityPage\n<<component>>" as CommPage
actor "Người dùng\n(Cộng đồng)" as Viewer

== Giai đoạn 1: Admin kiểm duyệt đóng góp ==

Admin -> AdminPage : 1. Truy cập /admin/contributions
activate AdminPage

AdminPage -> Store : 2. useStore() -> lấy contributions
activate Store
Store -> Storage : 3. getContributions() (khi hydrate)
activate Storage
Storage -> LS : 4. getItem("staywise_contributions")
LS --> Storage : 5. JSON string / fallback SEED_CONTRIBUTIONS
Storage --> Store : 6. Contribution[]
deactivate Storage
Store --> AdminPage : 7. contributions : Contribution[]
deactivate Store

AdminPage --> Admin : 8. Lọc tab activeTab = "pending"\n& hiển thị danh sách chờ duyệt

alt Admin nhấn nút "Duyệt"
  Admin -> AdminPage : 9a. handleApprove(id, authorName)
  AdminPage -> Store : 10a. approveContribution(id)
  activate Store
  Store -> Store : 11a. Cập nhật status = "approved", updatedAt
  Store -> Storage : 12a. saveContributions(next)
  activate Storage
  Storage -> LS : 13a. setItem("staywise_contributions", JSON)
  deactivate Storage
  Store --> AdminPage : 14a. State đã cập nhật
  deactivate Store
  AdminPage -> Toast : 15a. success("Đã phê duyệt đóng góp!", ...)
else Admin nhấn nút "Từ chối"
  Admin -> AdminPage : 9b. handleReject(id, authorName)
  AdminPage -> Store : 10b. rejectContribution(id)
  activate Store
  Store -> Store : 11b. Cập nhật status = "rejected", updatedAt
  Store -> Storage : 12b. saveContributions(next)
  activate Storage
  Storage -> LS : 13b. setItem("staywise_contributions", JSON)
  deactivate Storage
  Store --> AdminPage : 14b. State đã cập nhật
  deactivate Store
  AdminPage -> Toast : 15b. warning("Đã từ chối đóng góp!", ...)
end
deactivate AdminPage

== Giai đoạn 2: Người dùng xem bảng tin Cộng đồng ==

Viewer -> CommPage : 16. Truy cập /community
activate CommPage
CommPage -> Store : 17. useStore() -> lấy contributions
activate Store
Store --> CommPage : 18. contributions : Contribution[]
deactivate Store
CommPage -> CommPage : 19. Lọc chỉ lấy status === "approved"\n& áp dụng bộ lọc TP/khu vực/chủ đề
CommPage --> Viewer : 20. Hiển thị các bài đóng góp đã duyệt
deactivate CommPage
@enduml
