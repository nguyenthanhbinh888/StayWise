@startuml staywise_data_model
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam classStereotypeFontSize 11
skinparam classAttributeIconSize 0

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #17324D
  HeaderBackgroundColor #EAF0F6
}

title Mô hình Dữ liệu Cục bộ (Data Model) — Hệ thống StayWise

entity "Area" as Area {
  * **id** : string <<PK>>
  --
  slug : string
  name : string
  city : "hanoi" | "hcm"
  displayCity : string
  latitude : number
  longitude : number
  rent : { min, max, average }
  monthlyExpenses : { food, transportation, utilities, other }
  livingScores : { safety, quietness, trafficConvenience, environment, floodRisk }
  amenities : AmenityCounts
  description : string
  highlights : string[]
  updatedAt : string
}

entity "AmenityItem" as AmenityItem {
  * **id** : string <<PK>>
  --
  * **areaId** : string <<FK>>
  name : string
  category : AmenityCategory
  latitude : number
  longitude : number
  description : string
  distanceKm? : number
}

entity "AreaReview" as AreaReview {
  * **id** : string <<PK>>
  --
  * **areaId** : string <<FK>>
  authorName : string
  overallRating : number
  securityRating : number
  quietnessRating : number
  trafficRating : number
  floodingRating : number
  utilityRating : number
  content : string
  createdAt : string
}

entity "Contribution" as Contribution {
  * **id** : string <<PK>>
  --
  * **areaId** : string <<FK>>
  authorName : string
  category : ContributionCategory
  rating : number (1..5)
  content : string
  status : "pending" | "approved" | "rejected"
  createdAt : string
  updatedAt? : string
}

entity "Destination" as Destination {
  * **id** : string <<PK>>
  --
  name : string
  city : "hanoi" | "hcm"
  category : "university" | "workplace" | "landmark"
  latitude : number
  longitude : number
}

entity "CalculatorInputs" as CalculatorInputs {
  monthlyBudget : number
  rent : number
  food : number
  transportation : number
  electricity : number
  water : number
  internet : number
  personalExpenses : number
  contingencyExpenses : number
}

Area "1" -- "0..*" AmenityItem : "chứa (areaId)"
Area "1" -- "0..*" AreaReview : "có (areaId)"
Area "1" -- "0..*" Contribution : "nhận đóng góp (areaId)"

note bottom of Destination
  Destination không có quan hệ khóa ngoại
  lưu trữ với Area. Hàm calculateDistance()
  tính khoảng cách đường chim bay (Haversine)
  giữa tọa độ Area và Destination khi gợi ý.
end note

note right of CalculatorInputs
  Cơ chế lưu trữ bền vững cục bộ (Browser localStorage):
  • "staywise_areas" -> Area[]
  • "staywise_contributions" -> Contribution[]
  • "staywise_comparison_ids" -> string[] (tối đa 4 ID)
  • "staywise_saved_calculator_plan" -> CalculatorInputs
  (Dữ liệu gốc đọc từ src/data/*.ts khi chưa có hoặc khi reset)
end note
@enduml
